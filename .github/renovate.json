{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>hmcts/.github:renovate-config",
    "local>hmcts/.github//renovate/automerge-all"
  ],
  "labels": [
    "dependencies"
  ],
  "timezone": "Europe/London",
  "automergeSchedule": [
    "after 7am and before 8am every weekday",
    "after 6pm and before 8pm every weekday"
  ],
  "platformAutomerge": false,
  "schedule": [
    "after 7am and before 8am every weekday",
    "after 6pm and before 8pm every weekday"
  ],
  "rebaseWhen": "behind-base-branch",
  "automergeStrategy": "squash",
  "prConcurrentLimit": 5,
  "helmv3": {
    "bumpVersion": "patch"
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?\\sARG .*?_VERSION=(?<currentValue>.*)\\s"]
    }
  ],
  "packageRules": [
    {
      "enabled": false,
      "matchPackageNames": [
        "/pact/"
      ]
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Spring Boot and related updates",
      "groupSlug": "spring-boot-related",
      "automerge": true,
      "automergeType": "pr",
      "matchPackageNames": [
        "/org.springframework/",
        "/org.springdoc/",
        "/spring-boot/",
        "/spring-cloud/",
        "/jakarta.persistence/",
        "/org.hibernate/"
      ]
    },
    {
      "matchManagers": [
        "terraform"
      ],
      "groupName": "Terraform updates",
      "groupSlug": "terraform",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "All non-major updates",
      "groupSlug": "all-non-major",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Keep the Terraform CLI version (infrastructure/.terraform-version) out of the npm non-major group; large jumps can affect state and providers, so review and merge manually",
      "matchManagers": [
        "terraform-version"
      ],
      "groupName": "Terraform version",
      "groupSlug": "terraform-version",
      "automerge": false
    },
    {
      "description": "Keep the cnp-jenkins-library @Library bump in Jenkinsfiles out of the npm non-major group so pipeline changes are tested on their own",
      "matchDatasources": [
        "github-tags"
      ],
      "matchPackageNames": [
        "hmcts/cnp-jenkins-library"
      ],
      "groupName": "Jenkins library",
      "groupSlug": "jenkins-library"
    }
  ]
}
