<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <!-- Temporary. CVE-2026-33117 is Azure Key Vault Keys (azure_sdk_for_java CPE), not Application Insights.
         logging-appinsights 6.1.9 is the last release that still publishes this module. -->
    <suppress>
        <packageUrl regex="true">^pkg:maven/com\.microsoft\.azure/applicationinsights\-.*@.*$</packageUrl>
        <cve>CVE-2026-33117</cve>
    </suppress>

    <!-- Temporary. CVE-2025-21199 is the Azure Backup / Site Recovery agent installer, not Application Insights. -->
    <suppress>
        <packageUrl regex="true">^pkg:maven/com\.microsoft\.azure/applicationinsights\-core@.*$</packageUrl>
        <cve>CVE-2025-21199</cve>
    </suppress>
</suppressions>
